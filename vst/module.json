{
  "_comment": "Not a real Schwung module -- chain_params lists the VST parameters of ccmap_vst.cpp so mpc-vst-plugins' tools/gen_vst.py can generate params.h + the skin. Keys must match ccmap_vst.cpp (KEYS[]). The editor parameters (slot .. clear) always show the slot chosen with SLOT. New parameters are appended only (parameter numbers stay); projects and presets are restored from the plugin's own text state, not by index.",
  "chain_params": [
    {"key": "slot", "name": "Slot", "min": 1, "max": 128},
    {"key": "learn", "name": "Learn", "access": "write"},
    {"key": "source", "name": "Source", "min": 0, "max": 1},
    {"key": "page", "name": "Page", "options": ["ALL", "1", "2", "3", "4"]},
    {"key": "out", "name": "Out", "options": ["A", "B", "C", "D"]},
    {"key": "ch", "name": "Channel", "min": 1, "max": 16},
    {"key": "type", "name": "Type", "options": ["OFF", "CC", "NOTE", "PROGRAM", "PAGE"]},
    {"key": "num", "name": "Number", "min": 0, "max": 127},
    {"key": "lo", "name": "Min", "min": 0, "max": 127},
    {"key": "hi", "name": "Max", "min": 0, "max": 127},
    {"key": "btn", "name": "Button", "options": ["MOMENT", "TOGGLE"]},
    {"key": "clear", "name": "Clear", "access": "write"},
    {"key": "cur_page", "name": "Active Page", "options": ["1", "2", "3", "4"]},
    {"key": "follow", "name": "Follow", "options": ["OFF", "ON"]},
    {"key": "leds", "name": "LEDs", "options": ["OFF", "ON", "ON + TEMPLATE"]},
    {"key": "thru", "name": "Unmapped", "options": ["DROP", "THRU A"]},
    {"key": "link", "name": "Link A", "options": ["OFF", "CONTROL IN"]},
    {"key": "input", "name": "Input", "options": ["MY CONTROLLERS", "ALL USB"]},
    {"key": "arrows", "name": "Arrows", "options": ["PAGE/SLOT", "MAPPABLE"]},
    {"key": "monitor", "name": "Last", "min": 0, "max": 1},
    {"key": "preset", "name": "Preset", "min": 1, "max": 32},
    {"key": "load", "name": "Load", "access": "write"},
    {"key": "save", "name": "Save", "access": "write"},
    {"key": "enc", "name": "Encoder", "options": ["ABSOLUTE", "REL 64", "REL 2C"]},
    {"key": "feedback", "name": "Feedback", "options": ["OFF", "EC4 + E16", "+ ALL USB"]},
    {"key": "takeover", "name": "Takeover", "options": ["JUMP", "PICKUP"]},
    {"key": "send", "name": "Send Values", "access": "write"},
    {"key": "template", "name": "LC Template", "min": 0, "max": 1}
  ]
}
